<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="BIG TOYS – Karnataka's #1 luxury ride-on toy rental service. Lamborghinis, ATVs, Supercars & more available across all of Karnataka. Book now!" />
  <meta name="keywords" content="big toys Karnataka, luxury toy rental, ride on cars Karnataka, kids ride on, Lamborghini toy rental Bengaluru, toy rental Mysuru, kids entertainment Karnataka" />
  <meta name="author" content="BIG TOYS" />
  <meta property="og:title" content="BIG TOYS – Luxury Ride-On Toy Rentals Across Karnataka" />
  <meta property="og:description" content="Karnataka's most thrilling luxury toy rental experience. Supercars, ATVs, bikes & more. Book in 10 digits." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://bigtoys.in" />
  <title>BIG TOYS – Luxury Ride-On Rentals | All Over Karnataka</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,600;0,700;1,300&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>

<!-- NAV -->
<header class="nav-header" id="navbar">
  <div class="nav-inner">
    <a href="#hero" class="brand">
      <span class="brand-big">BIG</span><span class="brand-toys">TOYS</span>
      <span class="brand-tag">KARNATAKA</span>
    </a>
    <nav class="nav-links">
      <a href="#toys">Our Toys</a>
      <a href="#features">Features</a>
      <a href="#blog">Blog</a>
      <a href="#booking" class="nav-cta">Book Now</a>
    </nav>
    <button class="hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    <a href="#toys" onclick="closeMobile()">Our Toys</a>
    <a href="#features" onclick="closeMobile()">Features</a>
    <a href="#blog" onclick="closeMobile()">Blog</a>
    <a href="#booking" class="nav-cta" onclick="closeMobile()">Book Now</a>
  </div>
</header>

<!-- HERO -->
<section class="hero" id="hero">
  <div class="hero-bg">
    <div class="hero-grid"></div>
    <div class="hero-glow g1"></div>
    <div class="hero-glow g2"></div>
  </div>
  <div class="hero-content">
    <div class="hero-label">Available All Over Karnataka</div>
    <h1 class="hero-title">
      <span class="line1">DRIVE</span>
      <span class="line2">BIG.</span>
      <span class="line3">DREAM BIGGER.</span>
    </h1>
    <p class="hero-sub">Karnataka's most electrifying luxury ride-on toy rentals — supercars, ATVs & more delivered to your doorstep.</p>
    <div class="hero-actions">
      <a href="#booking" class="btn-primary">Book Your Toy</a>
      <a href="#toys" class="btn-ghost">See Our Fleet →</a>
    </div>
    <div class="hero-stats">
      <div class="stat"><span class="stat-n">500+</span><span class="stat-l">Happy Kids</span></div>
      <div class="stat-div"></div>
      <div class="stat"><span class="stat-n">30+</span><span class="stat-l">Districts Covered</span></div>
      <div class="stat-div"></div>
      <div class="stat"><span class="stat-n">15+</span><span class="stat-l">Premium Models</span></div>
    </div>
  </div>
  <div class="hero-scroll-hint">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- TOYS GALLERY -->
<section class="toys-section" id="toys">
  <div class="section-container">
    <div class="section-header">
      <div class="section-eyebrow">Our Premium Fleet</div>
      <h2 class="section-title">FAMOUS <span class="accent">TOYS</span></h2>
      <p class="section-sub">Each toy is meticulously maintained, fully charged, and delivered event-ready.</p>
    </div>
    <div class="toys-grid">

      <div class="toy-card" data-index="01">
        <div class="toy-img-wrap">
          <img src="https://images.unsplash.com/photo-1594736797933-d0501ba2fe65?w=700&q=80" alt="Kids Lamborghini Ride-On Car - BIG TOYS Karnataka" loading="lazy"/>
          <div class="toy-badge">Most Popular</div>
          <div class="toy-overlay"><a href="#booking" class="toy-book-btn">Book Now</a></div>
        </div>
        <div class="toy-info">
          <div class="toy-num">01</div>
          <h3 class="toy-name">Lamborghini Supercar</h3>
          <p class="toy-desc">A roaring replica with real working headlights and a 2-speed gearbox that delivers the ultimate miniature supercar experience.</p>
          <div class="toy-meta">
            <span class="toy-age">Ages 3–8</span>
            <span class="toy-price">From ₹499/hr</span>
          </div>
        </div>
      </div>

      <div class="toy-card" data-index="02">
        <div class="toy-img-wrap">
          <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&q=80" alt="Kids ATV Quad Ride-On - BIG TOYS Karnataka" loading="lazy"/>
          <div class="toy-overlay"><a href="#booking" class="toy-book-btn">Book Now</a></div>
        </div>
        <div class="toy-info">
          <div class="toy-num">02</div>
          <h3 class="toy-name">Monster ATV Quad</h3>
          <p class="toy-desc">Rugged all-terrain quad with oversized grip tyres and a parental remote override for maximum adventure with complete safety.</p>
          <div class="toy-meta">
            <span class="toy-age">Ages 4–10</span>
            <span class="toy-price">From ₹549/hr</span>
          </div>
        </div>
      </div>

      <div class="toy-card" data-index="03">
        <div class="toy-img-wrap">
          <img src="https://images.unsplash.com/photo-1612198273689-b4e84d8c1c56?w=700&q=80" alt="Kids Electric Sports Bike - BIG TOYS Karnataka" loading="lazy"/>
          <div class="toy-overlay"><a href="#booking" class="toy-book-btn">Book Now</a></div>
        </div>
        <div class="toy-info">
          <div class="toy-num">03</div>
          <h3 class="toy-name">Electric Sports Bike</h3>
          <p class="toy-desc">A fully battery-powered sport motorcycle with LED racing lights and authentic engine sound effects for the young speed enthusiast.</p>
          <div class="toy-meta">
            <span class="toy-age">Ages 3–7</span>
            <span class="toy-price">From ₹449/hr</span>
          </div>
        </div>
      </div>

      <div class="toy-card" data-index="04">
        <div class="toy-img-wrap">
          <img src="https://images.unsplash.com/photo-1565043666747-69f6646db940?w=700&q=80" alt="Mini Jeep SUV Ride-On - BIG TOYS Karnataka" loading="lazy"/>
          <div class="toy-overlay"><a href="#booking" class="toy-book-btn">Book Now</a></div>
        </div>
        <div class="toy-info">
          <div class="toy-num">04</div>
          <h3 class="toy-name">Luxury Mini Jeep SUV</h3>
          <p class="toy-desc">A two-seater electric Jeep replica with a working FM radio, USB port, and smooth suspension for the ultimate co-pilot experience.</p>
          <div class="toy-meta">
            <span class="toy-age">Ages 3–9</span>
            <span class="toy-price">From ₹599/hr</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="features-section" id="features">
  <div class="section-container">
    <div class="features-layout">
      <div class="features-left">
        <div class="section-eyebrow">Why BIG TOYS</div>
        <h2 class="section-title">THE <span class="accent">DIFFERENCE</span><br/>IS IN THE<br/>DETAILS.</h2>
        <p class="features-body">From Bengaluru to Bidar, Mysuru to Mangaluru — BIG TOYS delivers premium ride-on experiences at every event, birthday, or celebration across Karnataka.</p>
        <a href="#booking" class="btn-primary">Reserve Your Fleet</a>
      </div>
      <div class="features-right">
        <div class="feat-item">
          <div class="feat-icon">⚡</div>
          <div>
            <h4>Fully Charged & Event-Ready</h4>
            <p>Every toy arrives 100% charged with backup batteries included so the fun never stops.</p>
          </div>
        </div>
        <div class="feat-item">
          <div class="feat-icon">🛡️</div>
          <div>
            <h4>Safety-Certified Vehicles</h4>
            <p>Parental remote control, seat belts, and speed governors on every model for total peace of mind.</p>
          </div>
        </div>
        <div class="feat-item">
          <div class="feat-icon">🚚</div>
          <div>
            <h4>Doorstep Delivery Statewide</h4>
            <p>We deliver and pick up across all 30+ districts of Karnataka — you focus on the celebration.</p>
          </div>
        </div>
        <div class="feat-item">
          <div class="feat-icon">📸</div>
          <div>
            <h4>Photo-Worthy Setups</h4>
            <p>Branded backdrops and premium toy presentation for those priceless memory moments.</p>
          </div>
        </div>
        <div class="feat-item">
          <div class="feat-icon">🎉</div>
          <div>
            <h4>Events of All Sizes</h4>
            <p>Birthday parties, corporate events, school fairs, mall activations — no event is too big or small.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BOOKING -->
<section class="booking-section" id="booking">
  <div class="booking-bg"><div class="booking-glow"></div></div>
  <div class="section-container">
    <div class="section-header light">
      <div class="section-eyebrow">Quick Booking</div>
      <h2 class="section-title">BOOK IN <span class="accent">10 DIGITS</span></h2>
      <p class="section-sub">Enter your 10-digit mobile number and our team will call you back within 30 minutes.</p>
    </div>
    <div class="booking-wrapper">
      <div class="booking-card">
        <div class="booking-steps">
          <div class="bstep active" id="step-indicator-1">
            <span class="bstep-n">1</span><span class="bstep-l">Enter Number</span>
          </div>
          <div class="bstep-line"></div>
          <div class="bstep" id="step-indicator-2">
            <span class="bstep-n">2</span><span class="bstep-l">Choose Toy</span>
          </div>
          <div class="bstep-line"></div>
          <div class="bstep" id="step-indicator-3">
            <span class="bstep-n">3</span><span class="bstep-l">Confirm</span>
          </div>
        </div>

        <!-- Step 1 -->
        <div class="booking-step-content" id="booking-step-1">
          <h3>Enter Your 10-Digit Mobile Number</h3>
          <p class="booking-note">Our team will call you back within 30 minutes.</p>
          <div class="phone-input-wrap">
            <span class="phone-prefix">+91</span>
            <div class="digit-boxes" id="digitBoxes">
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 1"/>
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 2"/>
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 3"/>
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 4"/>
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 5"/>
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 6"/>
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 7"/>
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 8"/>
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 9"/>
              <input type="tel" maxlength="1" class="digit-box" inputmode="numeric" pattern="[0-9]" aria-label="Digit 10"/>
            </div>
          </div>
          <div class="digit-error" id="digitError">Please enter a valid 10-digit mobile number.</div>
          <button class="btn-primary full-w" id="nextStep1">Next: Choose Your Toy →</button>
        </div>

        <!-- Step 2 -->
        <div class="booking-step-content hidden" id="booking-step-2">
          <h3>Choose Your Toy & Event Details</h3>
          <div class="form-grid">
            <div class="form-group">
              <label>Select Toy</label>
              <select id="toySelect">
                <option value="">-- Pick a toy --</option>
                <option>Lamborghini Supercar</option>
                <option>Monster ATV Quad</option>
                <option>Electric Sports Bike</option>
                <option>Luxury Mini Jeep SUV</option>
                <option>Multiple Toys Package</option>
              </select>
            </div>
            <div class="form-group">
              <label>Event Date</label>
              <input type="date" id="eventDate" min=""/>
            </div>
            <div class="form-group">
              <label>Duration</label>
              <select id="duration">
                <option>1 Hour</option>
                <option>2 Hours</option>
                <option>Half Day (4 hrs)</option>
                <option>Full Day (8 hrs)</option>
              </select>
            </div>
            <div class="form-group">
              <label>City / District</label>
              <select id="citySelect">
                <option value="">-- Select district --</option>
                <option>Bengaluru Urban</option>
                <option>Bengaluru Rural</option>
                <option>Mysuru</option>
                <option>Mangaluru</option>
                <option>Hubballi-Dharwad</option>
                <option>Belagavi</option>
                <option>Kalaburagi</option>
                <option>Tumakuru</option>
                <option>Shivamogga</option>
                <option>Vijayapura</option>
                <option>Ballari</option>
                <option>Hassan</option>
                <option>Davanagere</option>
                <option>Udupi</option>
                <option>Raichur</option>
                <option>Other</option>
              </select>
            </div>
          </div>
          <div class="booking-btn-row">
            <button class="btn-ghost" id="backStep2">← Back</button>
            <button class="btn-primary" id="nextStep2">Confirm Booking →</button>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="booking-step-content hidden" id="booking-step-3">
          <div class="success-icon">🎉</div>
          <h3>Booking Request Received!</h3>
          <p class="booking-note">Our team will call <strong id="confirmPhone"></strong> within <strong>30 minutes</strong> to confirm your booking.</p>
          <div class="confirm-details" id="confirmDetails"></div>
          <div class="booking-promise">
            <span>✅ No advance payment</span>
            <span>✅ Free doorstep delivery</span>
            <span>✅ Cancel anytime</span>
          </div>
          <a href="https://wa.me/91XXXXXXXXXX?text=Hi%20BIG%20TOYS%2C%20I%20just%20submitted%20a%20booking!" class="btn-whatsapp" target="_blank" rel="noopener">📲 Also Message on WhatsApp</a>
          <button class="btn-ghost full-w" id="bookAgain" style="margin-top:12px">Book Another Toy</button>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="booking-sidebar">
        <div class="sidebar-card">
          <div class="sidebar-icon">📞</div>
          <h4>Call Us Directly</h4>
          <a href="tel:+91XXXXXXXXXX" class="sidebar-phone">+91 XXXXX XXXXX</a>
          <p>Mon–Sun · 8 AM – 9 PM</p>
        </div>
        <div class="sidebar-card">
          <div class="sidebar-icon">📍</div>
          <h4>Available Statewide</h4>
          <p>All 30+ districts of Karnataka — from Bengaluru to Bidar.</p>
        </div>
        <div class="sidebar-card highlight">
          <div class="sidebar-icon">⚡</div>
          <h4>Same-Day Booking</h4>
          <p>Order before 12 PM for same-day delivery in Bengaluru.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BLOG -->
<section class="blog-section" id="blog">
  <div class="section-container">
    <div class="section-header">
      <div class="section-eyebrow">SEO Blog</div>
      <h2 class="section-title">INSIGHTS &amp; <span class="accent">GUIDES</span></h2>
    </div>
    <div class="blog-grid">
      <article class="blog-card featured">
        <div class="blog-img">
          <img src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=700&q=80" alt="Best ride-on toy rentals in Karnataka" loading="lazy"/>
          <span class="blog-tag">Guide</span>
        </div>
        <div class="blog-body">
          <div class="blog-meta">June 2025 · 5 min read</div>
          <h3>Top 5 Ride-On Toys for Kids' Parties in Karnataka (2025)</h3>
          <p>Planning a birthday or event? Here's why luxury ride-on toy rentals are the biggest trend at kids' parties across Bengaluru, Mysuru, and beyond.</p>
          <a href="#" class="blog-read">Read Article →</a>
        </div>
      </article>
      <article class="blog-card">
        <div class="blog-img small">
          <img src="https://images.unsplash.com/photo-1531746790731-6c087fecd65a?w=400&q=80" alt="Safety tips for kids ride on toys" loading="lazy"/>
          <span class="blog-tag">Safety</span>
        </div>
        <div class="blog-body">
          <div class="blog-meta">May 2025 · 3 min read</div>
          <h3>Safety First: What to Check Before Renting a Ride-On Toy</h3>
          <p>Speed governors, parental remotes, and seat belts — a complete checklist for safe toy rentals at events.</p>
          <a href="#" class="blog-read">Read Article →</a>
        </div>
      </article>
      <article class="blog-card">
        <div class="blog-img small">
          <img src="https://images.unsplash.com/photo-1544717305-2782549b5136?w=400&q=80" alt="Kids event planning tips Karnataka" loading="lazy"/>
          <span class="blog-tag">Events</span>
        </div>
        <div class="blog-body">
          <div class="blog-meta">April 2025 · 4 min read</div>
          <h3>How to Plan the Perfect Kids' Event in Bengaluru</h3>
          <p>From venue selection to entertainment — the ultimate guide to unforgettable kids' events in Karnataka's capital city.</p>
          <a href="#" class="blog-read">Read Article →</a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- COVERAGE -->
<section class="coverage-section">
  <div class="section-container">
    <div class="coverage-inner">
      <div class="coverage-text">
        <div class="section-eyebrow">Pan-Karnataka Coverage</div>
        <h2 class="section-title">WE DELIVER <span class="accent">EVERYWHERE</span></h2>
        <p>From the hills of Coorg to the coasts of Mangaluru, from the heritage city of Hampi to the tech hub of Bengaluru — BIG TOYS reaches every corner of Karnataka.</p>
        <div class="district-tags">
          <span>Bengaluru</span><span>Mysuru</span><span>Mangaluru</span>
          <span>Hubballi</span><span>Belagavi</span><span>Kalaburagi</span>
          <span>Shivamogga</span><span>Tumakuru</span><span>Hassan</span>
          <span>Udupi</span><span>Ballari</span><span>Raichur</span>
          <span>+ 18 more</span>
        </div>
      </div>
      <div class="coverage-visual">
        <div class="karnataka-shape">
          <svg viewBox="0 0 300 320" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M60 20 L240 10 L280 60 L270 100 L290 150 L260 200 L240 260 L200 310 L150 300 L100 290 L60 250 L30 200 L10 150 L20 80 Z" fill="var(--accent-dim)" stroke="var(--accent)" stroke-width="2"/>
            <circle cx="140" cy="180" r="8" fill="var(--accent)" class="pulse-dot"/>
            <circle cx="100" cy="230" r="5" fill="var(--accent)" opacity="0.7"/>
